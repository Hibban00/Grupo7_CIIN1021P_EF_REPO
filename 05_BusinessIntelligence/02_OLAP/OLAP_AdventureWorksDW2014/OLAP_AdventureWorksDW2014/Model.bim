        "measures": [
          {
            "name": "Total Clientes",
            "expression": "DISTINCTCOUNT([ClienteDWKey])"
          },
          {
            "name": "Porcentaje de clientes por Sexo",
            "expression": "DIVIDE([Total Clientes],CALCULATE([Total Clientes],ALL(DimCliente[Genero])))"
          },
          {
            "name": "Mujeres",
            "expression": "CALCULATE([Total Clientes],DimCliente[Genero] = \"F\")"
          },
          {
            "name": "Varones",
            "expression": "CALCULATE([Total Clientes],DimCliente[Genero] = \"M\")"
          },
          {
            "name": "% Mujeres",
            "expression": "DIVIDE([Mujeres],[Total Clientes])"
          },
          {
            "name": "% Varones",
            "expression": "DIVIDE([Varones],[Total Clientes])"
