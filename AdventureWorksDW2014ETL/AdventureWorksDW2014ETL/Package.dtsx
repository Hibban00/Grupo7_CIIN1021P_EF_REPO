    <DTS:Executable
      DTS:refId="Package\SQL_FinalizarETL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{A3AFAFC9-9E97-493E-8281-370D304F30FE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_FinalizarETL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{126B3B0E-11D9-4931-AE64-00FA566EFFC3}"
          SQLTask:SqlStatementSource="UPDATE dbo.LogETL&#xA;SET&#xA;    FechaFin = SYSDATETIME(),&#xA;    RegistrosProcesados =&#xA;        (SELECT COUNT(*) FROM dbo.DimFecha)&#xA;        + (SELECT COUNT(*) FROM dbo.DimCliente)&#xA;        + (SELECT COUNT(*) FROM dbo.DimProducto)&#xA;        + (SELECT COUNT(*) FROM dbo.DimTerritorio)&#xA;        + (SELECT COUNT(*) FROM dbo.DimPromocion)&#xA;        + (SELECT COUNT(*) FROM dbo.DimMoneda)&#xA;        + (SELECT COUNT(*) FROM dbo.FactVentas),&#xA;    Estado = 'EXITOSO',&#xA;    Mensaje = 'Carga completa de dimensiones y tabla de hechos mediante SSIS.'&#xA;WHERE LogETLKey =&#xA;(&#xA;    SELECT MAX(LogETLKey)&#xA;    FROM dbo.LogETL&#xA;    WHERE Proceso = 'ETL SSIS PC5'&#xA;      AND Estado = 'EN PROCESO'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_IniciarETL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{52AD320F-BEBE-4922-87B7-505D19FE08FB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_IniciarETL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{126B3B0E-11D9-4931-AE64-00FA566EFFC3}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.LogETL&#xA;(&#xA;    Proceso,&#xA;    FechaInicio,&#xA;    FechaFin,&#xA;    RegistrosProcesados,&#xA;    Estado,&#xA;    Mensaje&#xA;)&#xA;VALUES&#xA;(&#xA;    'ETL SSIS PC5',&#xA;    SYSDATETIME(),&#xA;    NULL,&#xA;    0,&#xA;    'EN PROCESO',&#xA;    'Inicio de carga del Data Warehouse mediante SSIS.'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_LimpiarDestino"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{A4AC05F0-A075-4482-9D09-EAAB054C285C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_LimpiarDestino"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{126B3B0E-11D9-4931-AE64-00FA566EFFC3}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.FactVentas;&#xA;&#xA;DELETE FROM dbo.DimCliente;&#xA;DELETE FROM dbo.DimProducto;&#xA;DELETE FROM dbo.DimTerritorio;&#xA;DELETE FROM dbo.DimPromocion;&#xA;DELETE FROM dbo.DimMoneda;&#xA;DELETE FROM dbo.DimFecha;&#xA;&#xA;DBCC CHECKIDENT ('dbo.DimCliente', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimProducto', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimTerritorio', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimPromocion', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimMoneda', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.FactVentas', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
