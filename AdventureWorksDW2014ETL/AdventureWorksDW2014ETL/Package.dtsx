                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CustomerKey AS ClienteKey,
    CustomerAlternateKey AS CodigoCliente,
    Title AS Tratamiento,
    FirstName AS Nombre,
    MiddleName AS SegundoNombre,
    LastName AS Apellido,
    BirthDate AS FechaNacimiento,
    MaritalStatus AS EstadoCivil,
    Suffix AS Sufijo,
    Gender AS Genero,
    EmailAddress AS CorreoElectronico,
    YearlyIncome AS IngresoAnual,
    TotalChildren AS TotalHijos,
    NumberChildrenAtHome AS HijosEnCasa,
    EnglishEducation AS Educacion,
    EnglishOccupation AS Ocupacion,
    HouseOwnerFlag AS PropietarioVivienda,
    NumberCarsOwned AS CantidadVehiculos,
    DateFirstPurchase AS FechaPrimeraCompra,
    CommuteDistance AS DistanciaTraslado
FROM dbo.DimCustomer;</property>
